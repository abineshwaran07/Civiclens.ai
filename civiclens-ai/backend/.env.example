# Copy to backend/.env
# Leave GEMINI_API_KEY empty to run in offline demo mode (keyword search, no LLM).
GEMINI_API_KEY=
JWT_SECRET=change-me-to-a-long-random-string

# SQLite is fine for a demo. For PostgreSQL + pgvector use, for example:
# DATABASE_URL=postgresql://civiclens:civiclens@localhost:5432/civiclens
DATABASE_URL=sqlite:///./civiclens.db

# Set to false in any real deployment (the demo users have public passwords).
SEED_DEMO_DATA=true
